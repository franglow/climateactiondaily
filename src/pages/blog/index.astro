---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blog, postsByDate } from "../../data/posts";
import { getBlogSchema, getBreadcrumbSchema } from "../../utils/schema";

const pageTitle = `${blog.name} — ${blog.tagline}`;

const schemas = [
  getBlogSchema({ name: blog.name, description: blog.description }),
  getBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: blog.name, path: "/blog/" },
  ]),
];
---
<BaseLayout
  title={pageTitle}
  description={blog.description}
  lang="en"
  jsonLd={schemas}
>
  <section class="pt-12 md:pt-16 pb-4">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--base-prime)]">
        Essays
      </p>
      <h1 class="mt-3 font-serif text-4xl md:text-5xl font-bold leading-[1.05] tracking-tight">
        {blog.name}
      </h1>
      <p class="mt-4 text-lg md:text-xl text-[color:var(--base-ink)]/75 leading-relaxed max-w-2xl">
        {blog.description}
      </p>
    </div>
  </section>

  <section class="mt-10 md:mt-14 mb-20" aria-label="All essays">
    <ul class="max-w-3xl border-t border-[color:var(--base-line)]">
      {postsByDate.map((post) => (
        <li class="border-b border-[color:var(--base-line)]">
          <article class="py-8 md:py-10">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[color:var(--base-ink)]/55">
              <time datetime={post.date}>{post.dateLabel}</time>
              <span aria-hidden="true">·</span>
              <span>{post.readingMinutes} min read</span>
              {post.tags.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{post.tags.join(" / ")}</span>
                </>
              )}
            </div>

            <h2 class="mt-3 font-serif text-2xl md:text-3xl font-bold leading-tight tracking-tight">
              <a
                href={`/blog/${post.slug}/`}
                class="hover:text-[color:var(--base-prime)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--base-prime)]"
              >
                {post.title}
              </a>
            </h2>

            <p class="mt-2 text-base md:text-lg italic text-[color:var(--base-ink)]/70">
              {post.subtitle}
            </p>

            <p class="mt-4 text-[color:var(--base-ink)]/80 leading-relaxed max-w-2xl">
              {post.excerpt}
            </p>

            <p class="mt-5">
              <a
                href={`/blog/${post.slug}/`}
                class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--base-prime)] underline decoration-[color:var(--base-prime)]/30 underline-offset-4 hover:decoration-[color:var(--base-prime)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[color:var(--base-prime)]"
              >
                Read the essay
                <span aria-hidden="true">&rarr;</span>
              </a>
            </p>
          </article>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
